# ============================================================
# Pretty Good AI — patient voice bot
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- LiveKit Cloud (server + SIP + egress) -------------------
# From LiveKit Cloud console -> Settings -> Keys
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Twilio Elastic SIP Trunk (outbound PSTN) ---------------
# Termination URI from Twilio console, WITHOUT the sip: prefix
# e.g. pgai-patient-bot.pstn.twilio.com
TWILIO_TERMINATION_URI=
# Credential List username/password you created in Twilio.
# These must match exactly on both sides.
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
# The ONE Twilio number every call originates from, E.164.
OUTBOUND_CALLER_ID=+1XXXXXXXXXX

# Set once by `python setup_trunk.py`, then paste back here so we
# reuse a single trunk instead of creating a new one per run.
LIVEKIT_SIP_TRUNK_ID=

# --- STT: Deepgram nova-3 -----------------------------------
# STT_PROVIDER=deepgram talks to Deepgram directly (lower latency, needs a key).
# STT_PROVIDER=livekit routes the same nova-3 model through LiveKit's inference
# gateway using the LIVEKIT_* credentials above -- no Deepgram account needed.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3      # nova-2-phonecall is telephony-tuned; A/B in Phase 2

# --- TTS: Cartesia (default) --------------------------------
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# CARTESIA_MODEL=sonic-3
# Alternative TTS — set TTS_PROVIDER=elevenlabs to use these
# ELEVEN_API_KEY=
# ELEVENLABS_VOICE_ID=
TTS_PROVIDER=cartesia

# --- LLM: Anthropic Claude Haiku 4.5 (default) --------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# Alternative LLM — set LLM_PROVIDER=openai to use gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=anthropic

# --- Recording -----------------------------------------------
# Nothing to configure. The agents framework writes a stereo OGG/Opus file
# itself (far end on channel 0, our patient on channel 1) and we copy it into
# recordings/. No S3 or R2 bucket is needed -- see ARCHITECTURE.md for why we
# dropped LiveKit Egress.

# --- Turn taking / pacing (the tuning dials) -----------------
# Change one per call so you can attribute the result. See CHANGELOG.md.
# ENDPOINTING_MAX_DELAY=2.0      # ceiling when unsure the far end finished
# ENDPOINTING_MIN_DELAY=0.25     # floor before we treat a turn as over
# PREEMPTIVE_GENERATION=1        # speak before the turn is confirmed
# INTERRUPTION_MIN_DURATION=0.4  # speech length that counts as a barge-in
# INTERRUPTION_MIN_WORDS=2
# TURN_DETECTOR=inference        # or "local" for the free on-device model

# --- Analyzer (reads transcripts, writes BUG_REPORT.md) ------
# Reuses ANTHROPIC_API_KEY above. Override the model if you like.
ANALYZER_MODEL=claude-opus-5
